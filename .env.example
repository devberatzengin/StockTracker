# Copy to .env and fill in. Never commit .env.
# Variables use ASP.NET Core double-underscore notation (Section__Key).
# Used by docker compose (api, migrator). For local `dotnet run`, set the same
# variables in your shell or IDE run configuration.

# --- Runtime ---
# Development enables Swagger UI. Containers default to Production when unset.
ASPNETCORE_ENVIRONMENT=Production

# --- Database (external PostgreSQL) ---
# Npgsql connection string. Required: the API refuses to start without it.
# From inside Docker, a PostgreSQL running on your Mac is reachable as host.docker.internal.
# Example: Host=host.docker.internal;Port=5432;Database=stocktracker;Username=stocktracker;Password=change-me
# Remote servers usually need: ;SSL Mode=Require
ConnectionStrings__Default=

# --- Jwt ---
# Access tokens are HS256-signed; the key must be at least 32 characters and kept secret.
# Generate one with: openssl rand -base64 48
Jwt__Issuer=stocktracker
Jwt__Audience=stocktracker
Jwt__SigningKey=
# Optional (defaults shown): access token lifetime in minutes, refresh token lifetime in days.
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=7

# --- Public URL ---
# Base URL written into QR labels as {PUBLIC_BASE_URL}/s/{code} (label printing, phase 3.3).
# For phone testing use the cloudflared tunnel URL; in deployment the real domain.
PUBLIC_BASE_URL=

# --- Seed ---
# First admin, created at API startup if no user with this email exists (after migrations are applied).
# Password: at least 8 characters with upper case, lower case and a digit.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Storage (Phase 3.2) ---

# --- Cors ---
